{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./shims.d.ts"],
  "exclude": ["./antd/overlays/**/app/**", "./mui/overlays/**/app/**"]
}
