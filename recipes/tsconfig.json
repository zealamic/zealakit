{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./shims.d.ts",
    "./**/.storybook/**/*.ts",
    "./**/.storybook/**/*.tsx"
  ],
  "exclude": ["./antd/overlays/vite-react/**/app/**", "./mui/overlays/vite-react/**/app/**"]
}
