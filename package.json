{
  "name": "zealakit",
  "version": "1.0.0",
  "description": "Recipe-based scaffolding CLI for modern frontend projects",
  "type": "module",
  "bin": {
    "zealakit": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "recipes",
    "!recipes/tsconfig.json",
    "!recipes/shims.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "test:pack": "tsx scripts/test-e2e-pack.ts",
    "prepublishOnly": "npm run build",
    "create:test": "npx tsx src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "scaffold",
    "vite",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
